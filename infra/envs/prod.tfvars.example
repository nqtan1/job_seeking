# Prod (plan R wave 4, ADR 0041). Copy to envs/prod.tfvars (gitignored); every apply is approved by the owner.
project_id        = "prod-recruitai"
env               = "prod"
region            = "europe-west9" # Paris
billing_account   = "XXXXXX-XXXXXX-XXXXXX"
budget_amount_eur = 50 # set after the pricing calculator (ADR 0041 cost line)
tmp_ttl_days      = 1
sql_tier          = "db-custom-1-3840" # dedicated core: shared-core tiers have no SLA
sql_availability  = "REGIONAL"         # standby in a second zone, automatic failover
llm_backend       = "vertex"
llm_model         = "gemini-3.5-flash"
llm_location      = "eu"
github_repo       = "nqtan1/job_seeking"
alert_email       = "you@example.com"
deploy_run        = false # true after secrets have values and images are pushed
api_min_instances = 1     # no cold start
sentry_dsn        = ""    # backend Sentry project DSN (ADR 0040)
