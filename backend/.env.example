# Gemini model config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_FLASH=gemini-2.5-flash

# Vertex AI config
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-cloud-location

# Points to your local service account / ADC credentials file
GOOGLE_APPLICATION_CREDENTIALS=your-local-service-account

# France travail api
FRANCE_TRAVAIL_CLIENT_ID=your_client_id 
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret

# LLM Provider selection (gemini|qwen)
LLM_PROVIDER=gemini

# Qwen model (vLLM local endpoint) config
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct