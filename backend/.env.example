# ---------------------------------------------------------------------------
# TARGET APP (backend/src/recruitai) — see docs/ARCHITECTURE.md
# ---------------------------------------------------------------------------
ENV=local

# Firebase Auth emulator (backend/docker-compose.yaml). Never set this when
# ENV=prod — Settings refuses to start if both are set.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Must match backend/docker/.firebaserc's "default" project in dev/test.
FIREBASE_PROJECT_ID=demo-recruitai

# Log level for the JSON logs: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# App Check (core/app_check.py). Only ENV=local may disable enforcement (no emulator App
# Check setup needed for local dev) — ENV=prod can never turn it off.
# APP_CHECK_ENFORCED=true

# Postgres (backend/docker-compose.yaml). Must use the psycopg driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitai
# Optional pool/timeout tuning (defaults shown). Per-process connections = pool_size + max_overflow;
# instances * that must stay under Postgres max_connections.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_S=30
# DB_POOL_RECYCLE_S=1800
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Test database: tests refuse any name not containing "test" or equal to DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitai_test

# Storage (core/storage.py). local | gcs — must be gcs when ENV=prod.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=./.data
# LOCAL_STORAGE_SIGNING_SECRET=dev-only-signing-secret-do-not-use-in-prod
# GCS_BUCKET=your-gcs-bucket-name

# AI (ai/gateway.py, ai/gemini.py, ai/qwen.py). vertex | api_key | qwen — must be vertex
# Per-agent provider/model routing lives in config.yaml (gemini | qwen). Gemini auth is auto-detected:
# GOOGLE_GENAI_USE_VERTEXAI=true -> Vertex, else GEMINI_API_KEY -> API key. ENV=prod: Vertex only.
# AI_DAILY_QUOTA_PER_USER=50
# AI_CALL_TIMEOUT_S=30
# AI_MAX_RETRIES=3

# Gemini model config (GEMINI_FLASH_LITE/GEMINI_FLASH double as the target app's "fast"/
# "smart" model tiers — see Settings.gemini_flash_lite/gemini_flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_FLASH=gemini-2.5-flash

# Vertex AI config
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-cloud-location

# Points to your local service account / ADC credentials file
GOOGLE_APPLICATION_CREDENTIALS=your-local-service-account

# France travail api
FRANCE_TRAVAIL_CLIENT_ID=your_client_id 
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret


# Qwen model (vLLM local endpoint) config
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# Optional vision model (images). Unset = images go to the model above.
QWEN_VL_BASE_URL=http://localhost:8001/v1
QWEN_VL_API_KEY=your_qwen_vl_api_key_here
QWEN_VL_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ---------------------------------------------------------------------------
# AUTHENTICATION & MULTI-TENANCY
# ---------------------------------------------------------------------------
# This JSON object maps tenant IDs to a list of valid API keys.
# You can add as many tenants and keys as you need.
# Example: {"tenant-a": ["key1", "key2"], "tenant-b": ["key3"]}
TENANT_API_KEYS_JSON='{"default-tenant": ["secret-key-1"], "test-tenant": ["secret-key-2"]}'

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (core/email.py)
# ---------------------------------------------------------------------------
# "fake" records instead of sending (default). "brevo" sends for real and needs BREVO_API_KEY.
EMAIL_BACKEND=fake
# BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=no-reply@recruitai.example
EMAIL_SENDER_NAME=RecruitAI
