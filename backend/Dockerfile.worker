# Multi-stage uv-based build (ARCHITECTURE.md §6). Non-root at runtime. No Rust toolchain:
# Tectonic is a prebuilt static (musl) binary from its GitHub releases, not built from source.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Dependencies only. The project itself is NOT installed in the venv: the venv is then a
# layer that depends only on pyproject.toml/uv.lock, so an unchanged dependency set gives the
# same layer digest on every deploy and the registry stores it once (a deploy then adds only
# the small code layer below). The code runs from /app/src via PYTHONPATH.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project

FROM python:3.13-slim-bookworm AS tectonic
ARG TECTONIC_VERSION=0.17.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/tectonic.tar.gz \
       "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && tar -xzf /tmp/tectonic.tar.gz -C /usr/local/bin \
    && rm /tmp/tectonic.tar.gz \
    && chmod +x /usr/local/bin/tectonic

FROM python:3.13-slim-bookworm
RUN groupadd --system app && useradd --system --gid app --create-home app
COPY --from=tectonic /usr/local/bin/tectonic /usr/local/bin/tectonic
WORKDIR /app
COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app src /app/src
ENV PYTHONPATH=/app/src
COPY --chown=app:app config.prod.yaml /app/config.yaml
COPY --chown=app:app docker/sample.tex docker/sample-signature.png docker/render_check.py /app/docker/
ENV PATH="/app/.venv/bin:${PATH}"
RUN python -m compileall -q /app/src
ENV TECTONIC_CACHE_DIR=/home/app/.cache/Tectonic

# Pre-warm the package bundle (ADR 0010): compile the sample once, with network, at build
# time, so the runtime container never needs to fetch packages — proven by CI running this
# same image with --network none against the same file.
USER app
# The sample includes signature.png, so it is compiled in a directory where the picture sits
# under the exact name the templates use.
RUN mkdir -p /tmp/tectonic-warmup \
    && cp /app/docker/sample.tex /tmp/tectonic-warmup/sample.tex \
    && cp /app/docker/sample-signature.png /tmp/tectonic-warmup/signature.png \
    && tectonic -X compile --untrusted --outdir /tmp/tectonic-warmup /tmp/tectonic-warmup/sample.tex \
    && rm -rf /tmp/tectonic-warmup

CMD ["procrastinate", "--app=recruitai.worker.app", "worker"]
